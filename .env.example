# Copy this file to .env and edit as needed.
# Docker Compose configuration for local execution.
# Host vault path. In Docker Compose this is mounted to /data/Vault.
VAULT_DIR=./Vault
EXCLUDED_DIRS=
INCLUDED_FILETYPES=md
RAG_CHUNKING_MODE=structural
RAG_INDEX_WORKERS=4
MCP_URL=http://localhost:8000/mcp
OLLAMA_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=gemma4:12b-it-qat
